<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0, user-scalable=yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="工作台">
<meta name="theme-color" content="#4f46e5">
<title>我的工作台</title>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<style>
:root {
  --bg: #f5f5f7;
  --card: #ffffff;
  --text: #1d1d1f;
  --text-2: #86868b;
  --text-3: #aeaeb2;
  --border: #e5e5ea;
  --primary: #4f46e5;
  --primary-bg: #eef2ff;
  --success: #34c759;
  --success-bg: #e8f9ee;
  --warning: #ff9500;
  --warning-bg: #fff5e6;
  --danger: #ff3b30;
  --danger-bg: #ffeae8;
  --radius: 14px;
  --radius-sm: 10px;
  --shadow: 0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.02);
  --tab-h: 56px;
  --header-h: 52px;
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html, body { height:100%; overflow:hidden; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ===== App Shell ===== */
#app {
  display:flex; flex-direction:column;
  height: 90%; width: 90%; margin: 5% auto;
  position:relative; border-radius: 16px; overflow: hidden;
  box-shadow: 0 0 30px rgba(0,0,0,0.06);
}
.header {
  height: var(--header-h);
  display:flex; align-items:center; justify-content:space-between;
  padding: 0 20px;
  background: var(--card);
  border-bottom: 1px solid var(--border);
  position: relative; z-index: 10;
}
.header h1 { font-size: 18px; font-weight: 700; letter-spacing:-0.02em; }
.header .week-label { font-size: 13px; color: var(--text-2); }

.main {
  flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch;
  padding: 12px 12px 16px;
}
.tabbar {
  height: var(--tab-h);
  display:flex; background: var(--card);
  border-top: 1px solid var(--border);
  position: relative; z-index: 10;
}
.tab {
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:2px; color: var(--text-3); font-size: 11px; font-weight:500;
  cursor:pointer; transition: color .15s;
  -webkit-user-select:none; user-select:none;
}
.tab .tab-icon { font-size: 20px; line-height:1; }
.tab.active { color: var(--primary); }

/* ===== Pages ===== */
.page { display:none; }
.page.active { display:block; }

/* ===== Card ===== */
.card {
  background: var(--card); border-radius: var(--radius);
  padding: 16px; margin-bottom: 12px; box-shadow: var(--shadow);
}

/* ===== Todo: Week View ===== */
.week-nav {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom: 14px;
}
.week-nav button {
  background:none; border:none; color: var(--primary);
  font-size: 20px; cursor:pointer; padding: 6px 12px;
  min-width: 44px; min-height: 36px;
}
.week-nav .week-info { font-size: 14px; font-weight:600; text-align:center; }
.week-nav .week-info small { display:block; font-size:11px; color:var(--text-2); font-weight:400; }

.day-group { margin-bottom: 10px; }
.day-header {
  display:flex; align-items:center; justify-content:space-between;
  padding: 10px 14px; background: var(--card); border-radius: var(--radius-sm);
  cursor:pointer; -webkit-user-select:none; user-select:none;
  box-shadow: var(--shadow);
}
.day-header .day-name { font-weight:600; font-size: 14px; }
.day-header .day-date { font-size: 12px; color: var(--text-2); margin-left:6px; }
.day-header .day-count {
  font-size: 11px; color: var(--text-2);
  background: var(--bg); padding: 2px 8px; border-radius: 10px;
}
.day-header.today { background: var(--primary-bg); }
.day-header.today .day-name { color: var(--primary); }
.day-header .chevron { font-size: 12px; color: var(--text-3); transition: transform .2s; }
.day-header.collapsed .chevron { transform: rotate(-90deg); }

.day-items { display:block; padding-top: 8px; }
.day-items.hidden { display:none; }

.todo-item {
  display:flex; align-items:center; gap:10px;
  padding: 10px 14px; margin-top: 6px;
  background: var(--card); border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
}
.todo-check {
  width:22px; height:22px; border-radius:50%;
  border: 2px solid var(--border); cursor:pointer; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  transition: all .15s; background: white;
}
.todo-check.done { background: var(--success); border-color: var(--success); }
.todo-check.done::after { content:'✓'; color:white; font-size:13px; font-weight:700; }
.todo-body { flex:1; min-width:0; }
.todo-text { font-size: 14px; word-break: break-word; }
.todo-text.done { text-decoration: line-through; color: var(--text-3); }
.todo-meta { display:flex; align-items:center; gap:6px; margin-top:2px; }
.tag {
  font-size: 10px; padding: 1px 7px; border-radius: 8px; font-weight: 500;
}
.tag-morning { background: var(--warning-bg); color: var(--warning); }
.tag-afternoon { background: var(--primary-bg); color: var(--primary); }
.tag-evening { background: var(--success-bg); color: var(--success); }
.tag-overdue { background: var(--danger-bg); color: var(--danger); }
.todo-del {
  background:none; border:none; color: var(--text-3);
  font-size:18px; cursor:pointer; padding:4px 8px; flex-shrink:0;
}
.todo-del:hover { color: var(--danger); }

/* Add form */
.add-row {
  display:flex; gap:8px; margin-top: 10px;
}
.add-row input, .add-row select {
  padding: 10px 12px; border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 14px; outline:none;
  background: white;
}
.add-row input { flex:1; }
.add-row select { font-size: 13px; }
.add-row input:focus, .add-row select:focus { border-color: var(--primary); }
.btn-add {
  background: var(--primary); color: white; border:none;
  border-radius: var(--radius-sm); padding: 0 16px;
  font-size: 14px; font-weight:500; cursor:pointer;
  min-height: 44px;
}

/* ===== Project Cards (Work / Side) ===== */
.proj-card {
  background: var(--card); border-radius: var(--radius);
  padding: 16px; margin-bottom: 12px; box-shadow: var(--shadow);
  position: relative;
}
.proj-card .proj-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.proj-card .proj-title { font-size: 15px; font-weight:600; flex:1; word-break:break-word; }
.proj-card .proj-note { font-size: 13px; color: var(--text-2); margin-top: 6px; word-break:break-word; }
.proj-card .proj-meta { display:flex; align-items:center; gap:8px; margin-top: 10px; }
.proj-del {
  background:none; border:none; color: var(--text-3);
  font-size:16px; cursor:pointer; padding:2px 6px; flex-shrink:0;
}
.proj-del:hover { color: var(--danger); }

.status-pill {
  font-size: 11px; padding: 3px 10px; border-radius: 10px; font-weight:500;
  cursor:pointer; -webkit-user-select:none; user-select:none;
}
.status-active { background: var(--primary-bg); color: var(--primary); }
.status-done { background: var(--success-bg); color: var(--success); }
.status-paused { background: var(--bg); color: var(--text-2); }

.income-row {
  display:flex; gap:8px; margin-top: 8px; padding-top: 8px;
  border-top: 1px solid var(--border);
}
.income-row input { flex:1; padding: 8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; outline:none; }
.income-row input:focus { border-color: var(--primary); }
.income-log { font-size:12px; color: var(--text-2); margin-top:8px; }
.income-log span { color: var(--success); font-weight:600; }

/* ===== Study ===== */
.study-bar {
  height: 6px; background: var(--bg); border-radius: 3px; margin-top: 8px; overflow:hidden;
}
.study-bar-fill { height:100%; background: var(--primary); border-radius:3px; transition: width .3s; }
.study-percent { font-size:12px; color: var(--text-2); margin-top:4px; }
.study-time { font-size: 12px; color: var(--text-2); margin-top: 6px; }
.study-time span { color: var(--primary); font-weight:600; }
.study-actions { display:flex; gap:8px; margin-top:10px; }
.btn-sm {
  padding: 6px 14px; border-radius: 8px; font-size:12px; font-weight:500;
  border:none; cursor:pointer; min-height:36px;
}
.btn-timer { background: var(--primary-bg); color: var(--primary); }
.btn-timer.running { background: var(--danger-bg); color: var(--danger); }

/* ===== Study Stats ===== */
.study-stats {
  background: var(--card); border-radius: var(--radius);
  padding: 16px; margin-bottom: 14px; box-shadow: var(--shadow);
}
.study-stats-title { font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
.stats-grid { display:flex; gap: 12px; margin-bottom: 14px; }
.stat-box {
  flex:1; background: var(--bg); border-radius: var(--radius-sm);
  padding: 12px; text-align: center;
}
.stat-box .stat-val { font-size: 20px; font-weight: 700; color: var(--primary); }
.stat-box .stat-label { font-size: 11px; color: var(--text-2); margin-top: 2px; }
.stat-breakdown { font-size: 12px; color: var(--text-2); line-height: 1.8; }
.stat-breakdown-item { display:flex; justify-content:space-between; padding: 3px 0; border-bottom: 1px solid var(--border); }
.stat-breakdown-item:last-child { border-bottom: none; }
.stat-breakdown-item .sb-name { color: var(--text); }
.stat-breakdown-item .sb-time { color: var(--primary); font-weight: 500; }

/* ===== Empty State ===== */
.empty {
  text-align:center; color: var(--text-3); font-size:14px;
  padding: 48px 20px;
}

/* ===== Section Title ===== */
.section-title {
  font-size: 13px; font-weight:600; color: var(--text-2);
  margin: 4px 0 12px; text-transform: uppercase; letter-spacing: 0.05em;
}

/* ===== Edit inline ===== */
.edit-input {
  width:100%; padding:8px 10px; border:1px solid var(--primary);
  border-radius:8px; font-size:14px; outline:none; font-family:inherit;
  margin-top: 4px;
}

/* ===== Reflection Modal ===== */
.modal-overlay {
  display:none; position:fixed; inset:0; z-index:200;
  background: rgba(0,0,0,0.4);
  align-items:center; justify-content:center;
  padding: 20px;
}
.modal-overlay.show { display:flex; }
.modal {
  background: var(--card); border-radius: var(--radius);
  width: 100%; max-width: 400px; max-height: 85vh;
  overflow-y: auto; padding: 24px 20px;
  animation: modalIn .2s ease;
}
@keyframes modalIn { from{ opacity:0; transform:scale(0.95); } to{ opacity:1; transform:scale(1); } }
.modal h3 { font-size: 17px; font-weight: 700; margin-bottom: 4px; }
.modal .modal-sub { font-size: 13px; color: var(--text-2); margin-bottom: 18px; }
.modal .modal-task { font-size: 13px; font-weight:600; color: var(--primary); background: var(--primary-bg); padding: 8px 12px; border-radius: 8px; margin-bottom: 16px; }
.modal label { font-size: 13px; font-weight: 600; color: var(--text); display:block; margin-bottom: 6px; }
.modal textarea {
  width: 100%; border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 12px; font-size: 14px; outline: none; resize: vertical;
  min-height: 80px; font-family: inherit; line-height: 1.6; margin-bottom: 16px;
  background: var(--bg);
}
.modal textarea:focus { border-color: var(--primary); background: white; }
.modal-actions { display:flex; gap: 10px; margin-top: 4px; }
.modal-actions button { flex:1; padding: 12px; border-radius: var(--radius-sm); font-size: 15px; font-weight: 600; border: none; cursor:pointer; min-height: 44px; }
.btn-skip { background: var(--bg); color: var(--text-2); }
.btn-save-ref { background: var(--primary); color: white; }

/* ===== Reflection Table ===== */
.ref-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.ref-table {
  width: 100%; border-collapse: collapse; font-size: 12px;
  min-width: 500px;
}
.ref-table th {
  background: var(--primary-bg); color: var(--primary);
  font-weight: 600; font-size: 11px; text-align: left;
  padding: 10px 8px; white-space: nowrap;
  position: sticky; top: 0;
}
.ref-table td {
  padding: 10px 8px; border-bottom: 1px solid var(--border);
  vertical-align: top; word-break: break-word; line-height: 1.5;
}
.ref-table tr:nth-child(even) td { background: #fafafa; }
.ref-table .col-date { white-space: nowrap; color: var(--text-2); font-size: 11px; width: 70px; }
.ref-table .col-task { font-weight: 500; width: 25%; }
.ref-table .col-insight { color: var(--text); width: 35%; }
.ref-table .col-action { color: var(--success); width: 35%; }
.ref-table .col-del { width: 30px; text-align:center; }
.ref-table .del-btn { background:none; border:none; color: var(--text-3); cursor:pointer; font-size:16px; padding:2px 4px; }
.ref-table .del-btn:hover { color: var(--danger); }
.ref-summary { font-size: 13px; color: var(--text-2); margin-bottom: 12px; }
.ref-summary span { font-weight: 600; color: var(--primary); }

/* ===== Goals ===== */
.goal-card {
  background: var(--card); border-radius: var(--radius);
  padding: 16px; margin-bottom: 12px; box-shadow: var(--shadow);
  border-left: 3px solid var(--primary);
}
.goal-card.timeframe-year { border-left-color: var(--warning); }
.goal-card.timeframe-month { border-left-color: var(--success); }
.goal-card.timeframe-none { border-left-color: var(--text-3); }
.goal-card .goal-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.goal-card .goal-title { font-size: 15px; font-weight:600; flex:1; word-break:break-word; }
.goal-card .goal-note { font-size: 13px; color: var(--text-2); margin-top: 6px; word-break:break-word; line-height: 1.6; }
.goal-card .goal-note:empty::before { content: '点击添加目标描述...'; color: var(--text-3); }
.goal-card .goal-meta { display:flex; align-items:center; gap:8px; margin-top: 10px; flex-wrap:wrap; }
.goal-del {
  background:none; border:none; color: var(--text-3);
  font-size:16px; cursor:pointer; padding:2px 6px; flex-shrink:0;
}
.goal-del:hover { color: var(--danger); }
.tf-badge {
  font-size: 11px; padding: 3px 10px; border-radius: 10px; font-weight:500;
}
.tf-year { background: var(--warning-bg); color: var(--warning); }
.tf-month { background: var(--success-bg); color: var(--success); }
.tf-none { background: var(--bg); color: var(--text-2); }
.goal-status-row {
  margin-top: 12px; padding: 10px 12px;
  background: var(--bg); border-radius: var(--radius-sm);
  display:flex; align-items:flex-start; gap:6px; line-height: 1.6;
}
.goal-status-label { font-size: 13px; color: var(--text-2); font-weight: 600; white-space: nowrap; flex-shrink:0; }
.goal-status-text { font-size: 13px; color: var(--text); flex:1; word-break: break-word; cursor: pointer; }
.goal-status-text:empty::before { content: '点击设置当前状态...'; color: var(--text-3); }
.goal-progress-row { display:flex; align-items:center; gap:10px; margin-top: 10px; padding: 0 2px; }
.goal-bar {
  flex:1; height: 8px; background: var(--bg); border-radius: 4px; overflow:hidden;
}
.goal-bar-fill { height:100%; background: var(--primary); border-radius:4px; transition: width .3s; }
.goal-pct {
  font-size: 13px; font-weight: 600; color: var(--primary); min-width: 36px; text-align:right; cursor:pointer;
}
.goal-actions { display:flex; gap:8px; margin-top:10px; }
.goal-add-row { display:flex; gap:8px; margin-bottom: 14px; flex-wrap: wrap; }
.goal-add-row input, .goal-add-row select {
  padding: 10px 12px; border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 14px; outline:none; background: white;
}
.goal-add-row input { flex:1; min-width: 120px; }
.goal-add-row select { font-size: 13px; }
.goal-reminder {
  background: var(--primary-bg); border-radius: var(--radius-sm);
  padding: 12px 14px; margin-bottom: 14px; font-size: 13px; color: var(--primary);
  line-height: 1.6; display:flex; align-items:flex-start; gap:8px;
}

/* Tab bar 6 items */
.tab { font-size: 10px; }
.tab .tab-icon { font-size: 18px; }

/* Scrollbar */
::-webkit-scrollbar { width: 0; }

@media (min-width: 481px) {
  #app { box-shadow: 0 0 20px rgba(0,0,0,0.06); }
}
</style>
</head>
<body>
<div id="app">
  <!-- Header -->
  <div class="header">
    <h1 id="pageTitle">📋 待办</h1>
    <div style="display:flex;align-items:center;gap:6px;">
      <button class="btn-sm btn-timer" onclick="exportAll()" title="导出备份">📤</button>
      <button class="btn-sm btn-timer" onclick="importAll()" title="导入恢复">📥</button>
      <span class="week-label" id="headerRight"></span>
    </div>
  </div>

  <!-- Main -->
  <div class="main" id="main">

    <!-- ===== Todo Page ===== -->
    <div class="page active" id="page-todo">
      <div class="week-nav">
        <button onclick="changeWeek(-1)">‹</button>
        <div class="week-info" id="weekInfo"></div>
        <button onclick="changeWeek(1)">›</button>
      </div>
      <div class="add-row">
        <input type="text" id="todoInput" placeholder="添加待办..." maxlength="80">
        <select id="todoSlot">
          <option value="morning">上午</option>
          <option value="afternoon">下午</option>
          <option value="evening">晚上</option>
        </select>
        <select id="todoDay"></select>
        <button class="btn-add" onclick="addTodo()">+</button>
      </div>
      <div id="todoList" style="margin-top:14px;"></div>
    </div>

    <!-- ===== Work Page ===== -->
    <div class="page" id="page-work">
      <div class="section-title">工作项目</div>
      <div class="add-row" style="margin-top:0;margin-bottom:14px;">
        <input type="text" id="workInput" placeholder="新增工作项目..." maxlength="60">
        <button class="btn-add" onclick="addProject('work')">+</button>
      </div>
      <div id="workList"></div>
    </div>

    <!-- ===== Side Page ===== -->
    <div class="page" id="page-side">
      <div class="section-title">副业项目</div>
      <div class="add-row" style="margin-top:0;margin-bottom:14px;">
        <input type="text" id="sideInput" placeholder="新增副业项目..." maxlength="60">
        <button class="btn-add" onclick="addProject('side')">+</button>
      </div>
      <div id="sideList"></div>
    </div>

    <!-- ===== Study Page ===== -->
    <div class="page" id="page-study">
      <div class="section-title">学习计划</div>
      <div class="study-stats" id="studyStats"></div>
      <div class="add-row" style="margin-top:0;margin-bottom:14px;">
        <input type="text" id="studyInput" placeholder="新增学习项目..." maxlength="60">
        <button class="btn-add" onclick="addStudy()">+</button>
      </div>
      <div id="studyList"></div>
    </div>

    <!-- ===== Goals Page ===== -->
    <div class="page" id="page-goal">
      <div class="section-title">长期目标</div>
      <div class="goal-reminder" id="goalReminder"></div>
      <div class="goal-add-row">
        <input type="text" id="goalInput" placeholder="你的大目标是什么？" maxlength="80">
        <select id="goalTimeframe">
          <option value="none">不限时间</option>
          <option value="month">按月</option>
          <option value="year">按年</option>
        </select>
        <input type="month" id="goalDate" style="display:none;">
        <button class="btn-add" onclick="addGoal()">+</button>
      </div>
      <div id="goalList"></div>
    </div>

    <!-- ===== Reflection Page ===== -->
    <div class="page" id="page-reflection">
      <div class="section-title">心得归纳</div>
      <div class="ref-summary" id="refSummary"></div>
      <div id="reflectionContent"></div>
    </div>

  </div>

  <!-- Reflection Modal -->
  <div class="modal-overlay" id="refModal">
    <div class="modal">
      <h3>🎉 完成一项待办！</h3>
      <div class="modal-sub">花一分钟记录心得，让经验沉淀下来</div>
      <div class="modal-task" id="refModalTask"></div>
      <label>💡 心得感悟</label>
      <textarea id="refInsight" placeholder="做完这件事，你有什么感受、发现或收获？"></textarea>
      <label>🚀 可以落地转化的地方</label>
      <textarea id="refAction" placeholder="基于这次经验，以后可以怎么做、改进什么、应用到哪？"></textarea>
      <div class="modal-actions">
        <button class="btn-skip" onclick="closeRefModal(false)">跳过</button>
        <button class="btn-save-ref" onclick="closeRefModal(true)">保存心得</button>
      </div>
    </div>
  </div>

  <!-- Tab Bar -->
  <div class="tabbar">
    <div class="tab active" data-page="todo" onclick="switchPage('todo')">
      <span class="tab-icon">📋</span><span>待办</span>
    </div>
    <div class="tab" data-page="work" onclick="switchPage('work')">
      <span class="tab-icon">💼</span><span>工作</span>
    </div>
    <div class="tab" data-page="side" onclick="switchPage('side')">
      <span class="tab-icon">🌱</span><span>副业</span>
    </div>
    <div class="tab" data-page="study" onclick="switchPage('study')">
      <span class="tab-icon">📚</span><span>学习</span>
    </div>
    <div class="tab" data-page="goal" onclick="switchPage('goal')">
      <span class="tab-icon">🎯</span><span>目标</span>
    </div>
    <div class="tab" data-page="reflection" onclick="switchPage('reflection')">
      <span class="tab-icon">📝</span><span>心得</span>
    </div>
  </div>
</div>

<script>
// ===== Storage =====
const K = { todo:'wb_todos_v2', work:'wb_work_v2', side:'wb_side_v2', study:'wb_study_v2', reflection:'wb_reflections_v2', goal:'wb_goals_v2' };
function load(key){ try{ return JSON.parse(localStorage.getItem(key)) || []; }catch(e){ return []; } }
function save(key, val){ localStorage.setItem(key, JSON.stringify(val)); }

let todos = load(K.todo);
let works = load(K.work);
let sides = load(K.side);
let studies = load(K.study);
let reflections = load(K.reflection);
let goals = load(K.goal);
let pendingTodoId = null; // 待弹窗的待办ID

// ===== Utils =====
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,6);
const escapeHtml = s => { const d=document.createElement('div'); d.textContent=s; return d.innerHTML; };
function dateKey(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }

// ===== Week Logic =====
let weekOffset = 0;
const weekNames = ['日','一','二','三','四','五','六'];

function getWeekDays(offset){
  const now = new Date();
  const day = now.getDay() || 7; // 周日=7
  const monday = new Date(now);
  monday.setDate(now.getDate() - day + 1 + offset*7);
  const days = [];
  for(let i=0;i<7;i++){
    const d = new Date(monday); d.setDate(monday.getDate()+i);
    days.push(d);
  }
  return days;
}
function todayKey(){ return dateKey(new Date()); }

function renderWeekInfo(){
  const days = getWeekDays(weekOffset);
  const m1 = days[0].getMonth()+1, d1 = days[0].getDate();
  const m2 = days[6].getMonth()+1, d2 = days[6].getDate();
  const label = weekOffset===0?'本周':weekOffset===-1?'上周':weekOffset===1?'下周':`${weekOffset<0?'':'+'}${weekOffset}周`;
  document.getElementById('weekInfo').innerHTML = `${label}<small>${m1}/${d1} - ${m2}/${d2}</small>`;
  document.getElementById('headerRight').textContent = label;
}

function renderTodoDaySelect(){
  const days = getWeekDays(weekOffset);
  const sel = document.getElementById('todoDay');
  const cur = sel.value;
  sel.innerHTML = days.map((d,i)=>{
    const dk = dateKey(d);
    const isToday = dk === todayKey();
    return `<option value="${dk}">${weekNames[d.getDay()]} ${d.getMonth()+1}/${d.getDate()}${isToday?' (今天)':''}</option>`;
  }).join('');
  // 默认选今天，如果本周
  if(weekOffset===0){ sel.value = todayKey(); }
  else if(cur){ sel.value = cur; }
}

// ===== Todo Render =====
const slotOrder = { morning:0, afternoon:1, evening:2 };
const slotLabels = { morning:'上午', afternoon:'下午', evening:'晚上' };

function renderTodos(){
  const days = getWeekDays(weekOffset);
  const list = document.getElementById('todoList');
  let html = '';
  days.forEach(d => {
    const dk = dateKey(d);
    const isToday = dk === todayKey();
    const isPast = dk < todayKey();
    let dayTodos = todos.filter(t => t.date === dk);
    // 时段排序
    dayTodos.sort((a,b) => (slotOrder[a.slot]||0) - (slotOrder[b.slot]||0));
    const doneCount = dayTodos.filter(t=>t.done).length;
    const countText = dayTodos.length ? `${doneCount}/${dayTodos.length}` : '无';
    const collapsed = dayTodos.length === 0 ? 'collapsed' : '';
    const hidden = dayTodos.length === 0 ? 'hidden' : '';

    html += `<div class="day-group">
      <div class="day-header ${isToday?'today':''} ${collapsed}" onclick="toggleDay(this)">
        <div><span class="day-name">周${weekNames[d.getDay()]}</span><span class="day-date">${d.getMonth()+1}月${d.getDate()}日</span></div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="day-count">${countText}</span>
          <span class="chevron">▼</span>
        </div>
      </div>
      <div class="day-items ${hidden}">`;

    dayTodos.forEach(t => {
      const slot = t.slot || 'morning';
      // 过去日期且未完成 → 标记逾期
      const isOverdue = isPast && !t.done;
      const tagClass = isOverdue ? 'tag-overdue' : `tag-${slot}`;
      const tagText = isOverdue ? '⚠ 逾期' : slotLabels[slot] || '上午';
      html += `<div class="todo-item">
        <div class="todo-check ${t.done?'done':''}" onclick="toggleTodo('${t.id}')"></div>
        <div class="todo-body">
          <div class="todo-text ${t.done?'done':''}">${escapeHtml(t.text)}</div>
          <div class="todo-meta">
            <span class="tag ${tagClass}">${tagText}</span>
          </div>
        </div>
        <button class="todo-del" onclick="deleteTodo('${t.id}')">×</button>
      </div>`;
    });

    html += `</div></div>`;
  });
  list.innerHTML = html || '<div class="empty">暂无待办</div>';
}

// 未完成待办自动顺延到今天
function rolloverTodos(){
  const today = todayKey();
  let changed = false;
  todos.forEach(t => {
    if(!t.done && t.date < today){
      t.date = today;
      changed = true;
    }
  });
  if(changed) save(K.todo, todos);
}

function toggleDay(el){
  const items = el.nextElementSibling;
  if(items.classList.contains('hidden')){ items.classList.remove('hidden'); el.classList.remove('collapsed'); }
  else { items.classList.add('hidden'); el.classList.add('collapsed'); }
}

function addTodo(){
  const input = document.getElementById('todoInput');
  const slot = document.getElementById('todoSlot').value;
  const date = document.getElementById('todoDay').value;
  const text = input.value.trim();
  if(!text) return;
  todos.push({ id:uid(), text, slot, date, done:false });
  save(K.todo, todos);
  input.value = '';
  renderTodos();
}

function toggleTodo(id){
  const t = todos.find(t=>t.id===id);
  if(!t) return;
  t.done = !t.done;
  save(K.todo, todos);
  renderTodos();
  // 完成时（且没有已存的心得）弹出心得弹窗
  if(t.done && !t.hasReflection){
    pendingTodoId = id;
    showRefModal(t.text);
  }
}

// ===== Reflection Modal =====
function showRefModal(taskText){
  document.getElementById('refModalTask').textContent = '✓ ' + taskText;
  document.getElementById('refInsight').value = '';
  document.getElementById('refAction').value = '';
  document.getElementById('refModal').classList.add('show');
  setTimeout(() => document.getElementById('refInsight').focus(), 100);
}

function closeRefModal(doSave){
  const modal = document.getElementById('refModal');
  modal.classList.remove('show');
  if(doSave && pendingTodoId){
    const insight = document.getElementById('refInsight').value.trim();
    const action = document.getElementById('refAction').value.trim();
    if(insight || action){
      const t = todos.find(t=>t.id===pendingTodoId);
      const taskText = t ? t.text : '';
      const taskDate = t ? t.date : todayKey();
      reflections.unshift({
        id: uid(),
        task: taskText,
        date: taskDate,
        insight: insight,
        action: action,
        createdAt: new Date().toISOString()
      });
      save(K.reflection, reflections);
      if(t) t.hasReflection = true;
      save(K.todo, todos);
      renderReflections();
    }
  }
  pendingTodoId = null;
}

// ===== Reflection Table =====
function renderReflections(){
  const summary = document.getElementById('refSummary');
  const content = document.getElementById('reflectionContent');

  if(reflections.length === 0){
    summary.textContent = '';
    content.innerHTML = '<div class="empty">完成待办后写心得，这里会自动归纳成表格 📝</div>';
    return;
  }

  const weekCount = reflections.filter(r => {
    const d = new Date(r.createdAt);
    const now = new Date();
    return (now - d) < 7 * 86400000;
  }).length;

  summary.innerHTML = `共 <span>${reflections.length}</span> 条心得 · 本周 <span>${weekCount}</span> 条`;

  // 按日期倒序
  const sorted = [...reflections].sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));

  let html = `<div class="ref-table-wrap"><table class="ref-table">
    <thead><tr>
      <th class="col-date">日期</th>
      <th class="col-task">待办事项</th>
      <th class="col-insight">💡 心得感悟</th>
      <th class="col-action">🚀 落地转化</th>
      <th class="col-del"></th>
    </tr></thead><tbody>`;

  sorted.forEach(r => {
    const d = r.date ? r.date.slice(5) : '--';
    html += `<tr>
      <td class="col-date">${escapeHtml(d)}</td>
      <td class="col-task">${escapeHtml(r.task)}</td>
      <td class="col-insight">${escapeHtml(r.insight) || '<span style="color:var(--text-3)">—</span>'}</td>
      <td class="col-action">${escapeHtml(r.action) || '<span style="color:var(--text-3)">—</span>'}</td>
      <td class="col-del"><button class="del-btn" onclick="deleteReflection('${r.id}')">×</button></td>
    </tr>`;
  });

  html += `</tbody></table></div>`;
  content.innerHTML = html;
}

function deleteReflection(id){
  if(!confirm('确定删除这条心得？')) return;
  reflections = reflections.filter(r => r.id !== id);
  save(K.reflection, reflections);
  renderReflections();
}

// ===== Goals =====
const tfLabels = { year:'年度目标', month:'月度目标', none:'长期目标' };
const tfClasses = { year:'timeframe-year', month:'timeframe-month', none:'timeframe-none' };
const tfBadgeClasses = { year:'tf-year', month:'tf-month', none:'tf-none' };

function renderGoals(){
  const list = document.getElementById('goalList');
  const reminder = document.getElementById('goalReminder');

  // 提醒语：把大目标和今天的待办完成情况关联
  const activeGoals = goals.filter(g => g.status !== '已达成');
  if(activeGoals.length > 0){
    const todayTodos = todos.filter(t => t.date === todayKey());
    const todayDone = todayTodos.filter(t => t.done).length;
    const goalTexts = activeGoals.slice(0,2).map(g => `「${g.title}」`).join('、');
    const extra = activeGoals.length > 2 ? ` 等${activeGoals.length}个` : '';
    reminder.style.display = '';
    reminder.innerHTML = `<span>💪</span><div>今天的每一步都在靠近：<strong>${goalTexts}${extra}</strong><br>今日待办完成 <strong>${todayDone}/${todayTodos.length}</strong>，坚持就是复利。</div>`;
  } else {
    reminder.style.display = 'none';
  }

  if(goals.length === 0){
    list.innerHTML = '<div class="empty">设立你的第一个大目标 🎯<br>让它成为每天行动的意义</div>';
    return;
  }

  // 按创建时间倒序
  const sorted = [...goals].sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));

  list.innerHTML = sorted.map(g => {
    const tf = g.timeframe || 'none';
    let dateText = '';
    if(tf === 'year' && g.date){
      dateText = ` · ${g.date}年`;
    } else if(tf === 'month' && g.date){
      dateText = ` · ${g.date}`;
    }
    const daysLeft = calcDaysLeft(g);
    const isDone = g.status === '已达成';
    return `<div class="goal-card ${tfClasses[tf]}">
      <div class="goal-top">
        <div style="flex:1;">
          <div class="goal-title" onclick="editGoal('${g.id}','title',this)">${escapeHtml(g.title)}</div>
          <div class="goal-note" onclick="editGoal('${g.id}','note',this)">${escapeHtml(g.note||'')}</div>
        </div>
        <button class="goal-del" onclick="deleteGoal('${g.id}')">×</button>
      </div>
      <div class="goal-meta">
        <span class="tf-badge ${tfBadgeClasses[tf]}">${tfLabels[tf]}${escapeHtml(dateText)}</span>
        ${daysLeft !== null ? `<span class="tf-badge tf-none">剩余 ${daysLeft} 天</span>` : ''}
        ${isDone?'<span class="tf-badge tf-month">✓ 已达成</span>':''}
      </div>
      <div class="goal-status-row">
        <span class="goal-status-label">📍 现阶段状态：</span>
        <span class="goal-status-text" onclick="editGoalStatus('${g.id}',this)">${escapeHtml(g.status||'点击设置当前状态...')}</span>
      </div>
      <div class="goal-progress-row">
        <div class="goal-bar"><div class="goal-bar-fill" style="width:${g.progress||0}%; ${isDone?'background:var(--success)':''}"></div></div>
        <span class="goal-pct" onclick="adjustGoalProgress('${g.id}')">${g.progress||0}%</span>
      </div>
    </div>`;
  }).join('');
}

function calcDaysLeft(g){
  if(!g.date || g.timeframe === 'none') return null;
  let target;
  if(g.timeframe === 'year'){
    target = new Date(parseInt(g.date), 11, 31, 23, 59, 59);
  } else if(g.timeframe === 'month'){
    const [y, m] = g.date.split('-').map(Number);
    target = new Date(y, m, 0, 23, 59, 59); // 月末
  } else {
    return null;
  }
  const diff = Math.ceil((target - new Date()) / 86400000);
  return diff > 0 ? diff : 0;
}

function addGoal(){
  const input = document.getElementById('goalInput');
  const tf = document.getElementById('goalTimeframe').value;
  const dateInput = document.getElementById('goalDate');
  const text = input.value.trim();
  if(!text) return;
  let date = '';
  if(tf === 'year' && dateInput.value){
    date = dateInput.value.split('-')[0]; // 取年份
  } else if(tf === 'month' && dateInput.value){
    date = dateInput.value; // YYYY-MM
  }
  goals.push({ id:uid(), title:text, note:'', timeframe:tf, date, status:'', progress:0, createdAt:new Date().toISOString() });
  save(K.goal, goals);
  input.value = '';
  dateInput.value = '';
  renderGoals();
}

function deleteGoal(id){
  if(!confirm('确定删除这个目标？')) return;
  goals = goals.filter(g => g.id !== id);
  save(K.goal, goals);
  renderGoals();
}

function editGoal(id, field, el){
  const g = goals.find(g => g.id === id);
  if(!g) return;
  const oldVal = g[field] || '';
  el.innerHTML = `<input class="edit-input" value="${escapeHtml(oldVal)}" id="eg-${id}">`;
  const input = document.getElementById('eg-'+id);
  input.focus(); input.select();
  const finish = () => { g[field] = input.value.trim(); save(K.goal, goals); renderGoals(); };
  input.addEventListener('blur', finish);
  input.addEventListener('keydown', e => { if(e.key==='Enter') input.blur(); if(e.key==='Escape') renderGoals(); });
}

function editGoalStatus(id, el){
  const g = goals.find(g => g.id === id);
  if(!g) return;
  const oldVal = g.status || '';
  el.innerHTML = `<input class="edit-input" value="${escapeHtml(oldVal)}" id="gs-${id}" placeholder="如：已完成基础知识学习，正在做实战项目">`;
  const input = document.getElementById('gs-'+id);
  input.focus(); input.select();
  const finish = () => { g.status = input.value.trim(); save(K.goal, goals); renderGoals(); };
  input.addEventListener('blur', finish);
  input.addEventListener('keydown', e => { if(e.key==='Enter') input.blur(); if(e.key==='Escape') renderGoals(); });
}

function adjustGoalProgress(id){
  const g = goals.find(g => g.id === id);
  if(!g) return;
  const val = prompt('设置进度 (0-100):', g.progress||0);
  if(val === null) return;
  const pct = Math.max(0, Math.min(100, parseInt(val)||0));
  g.progress = pct;
  if(pct >= 100 && !g.status) g.status = '已达成';
  save(K.goal, goals);
  renderGoals();
}

function deleteTodo(id){
  todos = todos.filter(t=>t.id!==id);
  save(K.todo, todos);
  renderTodos();
}

function changeWeek(n){
  weekOffset += n;
  renderWeekInfo();
  renderTodoDaySelect();
  renderTodos();
}

// ===== Work / Side Projects =====
function renderProjects(type){
  const arr = type==='work'?works:sides;
  const list = document.getElementById(type+'List');
  if(arr.length===0){ list.innerHTML = '<div class="empty">暂无项目，添加一个吧</div>'; return; }
  list.innerHTML = arr.map(p => {
    const statusClass = p.status==='done'?'status-done':p.status==='paused'?'status-paused':'status-active';
    const statusText = p.status==='done'?'已完成':p.status==='paused'?'搁置':'进行中';
    let incomeHtml = '';
    if(type==='side'){
      const total = (p.incomes||[]).reduce((s,i)=>s+Number(i.amount),0);
      incomeHtml = `
        <div class="income-row">
          <input type="number" placeholder="收入金额" id="inc-${p.id}" min="0" step="0.01">
          <button class="btn-sm btn-timer" onclick="addIncome('${p.id}')">记收入</button>
        </div>
        ${total>0?`<div class="income-log">累计收入：<span>¥${total.toFixed(2)}</span></div>`:''}
      `;
    }
    return `<div class="proj-card">
      <div class="proj-top">
        <div style="flex:1;">
          <div class="proj-title" onclick="editField('${type}','${p.id}','title',this)">${escapeHtml(p.title)}</div>
          ${p.note?`<div class="proj-note" onclick="editField('${type}','${p.id}','note',this)">${escapeHtml(p.note)}</div>`:`<div class="proj-note" style="color:var(--text-3)" onclick="editField('${type}','${p.id}','note',this)">点击添加备注...</div>`}
        </div>
        <button class="proj-del" onclick="deleteProject('${type}','${p.id}')">×</button>
      </div>
      <div class="proj-meta">
        <span class="status-pill ${statusClass}" onclick="cycleStatus('${type}','${p.id}')">${statusText}</span>
      </div>
      ${incomeHtml}
    </div>`;
  }).join('');
}

function addProject(type){
  const input = document.getElementById(type+'Input');
  const text = input.value.trim();
  if(!text) return;
  const arr = type==='work'?works:sides;
  arr.push({ id:uid(), title:text, note:'', status:'active', incomes:[] });
  save(type==='work'?K.work:K.side, arr);
  input.value='';
  renderProjects(type);
}

function deleteProject(type,id){
  if(!confirm('确定删除？')) return;
  if(type==='work'){ works = works.filter(p=>p.id!==id); save(K.work, works); renderProjects('work'); }
  else { sides = sides.filter(p=>p.id!==id); save(K.side, sides); renderProjects('side'); }
}

function cycleStatus(type,id){
  const arr = type==='work'?works:sides;
  const p = arr.find(p=>p.id===id);
  if(!p) return;
  const order = ['active','done','paused'];
  p.status = order[(order.indexOf(p.status)+1)%3];
  save(type==='work'?K.work:K.side, arr);
  renderProjects(type);
}

function editField(type,id,field,el){
  const arr = type==='work'?works:sides;
  const p = arr.find(p=>p.id===id);
  if(!p) return;
  const oldVal = p[field]||'';
  el.innerHTML = `<input class="edit-input" value="${escapeHtml(oldVal)}" id="ef-${id}">`;
  const input = document.getElementById('ef-'+id);
  input.focus(); input.select();
  const finish = () => {
    p[field] = input.value.trim();
    save(type==='work'?K.work:K.side, arr);
    renderProjects(type);
  };
  input.addEventListener('blur', finish);
  input.addEventListener('keydown', e => { if(e.key==='Enter') input.blur(); if(e.key==='Escape') renderProjects(type); });
}

function addIncome(pid){
  const input = document.getElementById('inc-'+pid);
  const amount = parseFloat(input.value);
  if(!amount || amount<=0) return;
  const p = sides.find(p=>p.id===pid);
  if(!p) return;
  if(!p.incomes) p.incomes = [];
  p.incomes.push({ amount, date: dateKey(new Date()) });
  save(K.side, sides);
  renderProjects('side');
}

// ===== Study =====
let timerState = { id:null, start:0 };
function renderStudies(){
  if(studies.length===0){ document.getElementById('studyList').innerHTML='<div class="empty">暂无学习计划，添加一个吧</div>'; return; }
  document.getElementById('studyList').innerHTML = studies.map(s => {
    const pct = s.progress||0;
    const hours = Math.floor((s.seconds||0)/3600);
    const mins = Math.floor(((s.seconds||0)%3600)/60);
    const timeStr = hours>0?`${hours}小时${mins}分`:`${mins}分钟`;
    const running = timerState.id===s.id;
    return `<div class="proj-card">
      <div class="proj-top">
        <div style="flex:1;">
          <div class="proj-title" onclick="editStudy('${s.id}','title',this)">${escapeHtml(s.title)}</div>
          ${s.note?`<div class="proj-note" onclick="editStudy('${s.id}','note',this)">${escapeHtml(s.note)}</div>`:`<div class="proj-note" style="color:var(--text-3)" onclick="editStudy('${s.id}','note',this)">点击添加笔记...</div>`}
        </div>
        <button class="proj-del" onclick="deleteStudy('${s.id}')">×</button>
      </div>
      <div class="proj-meta">
        <span class="status-pill ${pct>=100?'status-done':'status-active'}" onclick="adjustProgress('${s.id}')">${pct}%</span>
      </div>
      <div class="study-bar"><div class="study-bar-fill" style="width:${pct}%"></div></div>
      <div class="study-time">已学：<span>${timeStr}</span></div>
      <div class="study-actions">
        <button class="btn-sm btn-timer ${running?'running':''}" onclick="toggleTimer('${s.id}')">${running?'⏸ 停止':'▶ 开始计时'}</button>
      </div>
    </div>`;
  }).join('');
  renderStudyStats();
}

function addStudy(){
  const input = document.getElementById('studyInput');
  const text = input.value.trim();
  if(!text) return;
  studies.push({ id:uid(), title:text, note:'', progress:0, seconds:0 });
  save(K.study, studies);
  input.value='';
  renderStudies();
}

function deleteStudy(id){
  if(!confirm('确定删除？')) return;
  if(timerState.id===id) stopTimer();
  studies = studies.filter(s=>s.id!==id);
  save(K.study, studies);
  renderStudies();
}

function editStudy(id,field,el){
  const s = studies.find(s=>s.id===id);
  if(!s) return;
  const oldVal = s[field]||'';
  el.innerHTML = `<input class="edit-input" value="${escapeHtml(oldVal)}" id="es-${id}">`;
  const input = document.getElementById('es-'+id);
  input.focus(); input.select();
  const finish = () => { s[field]=input.value.trim(); save(K.study,studies); renderStudies(); };
  input.addEventListener('blur', finish);
  input.addEventListener('keydown', e=>{ if(e.key==='Enter') input.blur(); if(e.key==='Escape') renderStudies(); });
}

function adjustProgress(id){
  const s = studies.find(s=>s.id===id);
  if(!s) return;
  const val = prompt('设置进度 (0-100):', s.progress||0);
  if(val===null) return;
  const pct = Math.max(0, Math.min(100, parseInt(val)||0));
  s.progress = pct;
  save(K.study, studies);
  renderStudies();
}

let timerInterval = null;
function toggleTimer(id){
  if(timerState.id===id) stopTimer();
  else startTimer(id);
}
function startTimer(id){
  stopTimer();
  timerState = { id, start: Date.now() };
  timerInterval = setInterval(() => {
    const s = studies.find(s=>s.id===id);
    if(s){ s.seconds = (s.seconds||0) + 1; save(K.study, studies); }
  }, 1000);
  renderStudies();
}
function stopTimer(){
  if(timerInterval){ clearInterval(timerInterval); timerInterval=null; }
  // 停止时记录一条学习日志
  if(timerState.id){
    const s = studies.find(s=>s.id===timerState.id);
    if(s){
      if(!s.logs) s.logs = [];
      s.logs.push({ date: todayKey(), seconds: s.seconds - (s.lastLogSeconds||0) });
      s.lastLogSeconds = s.seconds;
      save(K.study, studies);
    }
  }
  timerState = { id:null, start:0 };
  renderStudies();
  renderStudyStats();
}

// ===== Data Backup / Restore (Excel) =====
function exportAll(){
  // 弹出月份选择
  showExportModal();
}

function showExportModal(){
  const now = new Date();
  const thisMonth = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
  const monthVal = prompt('导出哪个月的数据？\n格式：YYYY-MM\n留空则导出全部', thisMonth);
  if(monthVal === null) return; // 取消
  const filterMonth = monthVal.trim();
  if(filterMonth && !/^\d{4}-\d{2}$/.test(filterMonth)){
    alert('格式错误，请输入如 2026-07');
    return;
  }
  doExport(filterMonth || null);
}

function doExport(filterMonth){
  const wb = XLSX.utils.book_new();
  const prefix = filterMonth ? filterMonth.replace('-','') + '-' : '';

  // Sheet 1: 待办事项
  const todoData = [];
  const sortedTodos = [...todos]
    .filter(t => !filterMonth || (t.date||'').startsWith(filterMonth))
    .sort((a,b) => (b.date||'').localeCompare(a.date||''));
  sortedTodos.forEach(t => {
    const slot = {morning:'上午', afternoon:'下午', evening:'晚上'}[t.slot]||'上午';
    todoData.push({
      '日期': t.date || '',
      '待办内容': t.text,
      '时段': slot,
      '状态': t.done ? '已完成' : '未完成'
    });
  });
  if(todoData.length === 0) todoData.push({ '日期':'','待办内容':'暂无数据','时段':'','状态':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(todoData), '待办事项');

  // Sheet 2: 工作项目（全部导出，不按月过滤）
  const workData = works.map(p => ({
    '项目名称': p.title,
    '状态': {active:'进行中', done:'已完成', paused:'搁置'}[p.status] || p.status,
    '备注': p.note || ''
  }));
  if(workData.length === 0) workData.push({ '项目名称':'暂无数据','状态':'','备注':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(workData), '工作项目');

  // Sheet 3: 副业项目（全部导出，按月过滤收入）
  const sideData = sides.map(p => {
    const filteredIncomes = filterMonth ? (p.incomes||[]).filter(i => (i.date||'').startsWith(filterMonth)) : (p.incomes||[]);
    const total = filteredIncomes.reduce((s,i)=>s+Number(i.amount),0);
    return {
      '项目名称': p.title,
      '状态': {active:'进行中', done:'已完成', paused:'搁置'}[p.status] || p.status,
      '备注': p.note || '',
      '累计收入': total.toFixed(2)
    };
  });
  if(sideData.length === 0) sideData.push({ '项目名称':'暂无数据','状态':'','备注':'','累计收入':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(sideData), '副业项目');

  // Sheet 4: 学习记录（按月过滤日志）
  const studyData = [];
  studies.forEach(s => {
    const hours = Math.floor((s.seconds||0)/3600);
    const mins = Math.floor(((s.seconds||0)%3600)/60);
    const filteredLogs = filterMonth ? (s.logs||[]).filter(l => (l.date||'').startsWith(filterMonth)) : (s.logs||[]);
    studyData.push({
      '学习项目': s.title,
      '总学习时长': `${hours}小时${mins}分钟`,
      '进度': `${s.progress||0}%`,
      '笔记': s.note || ''
    });
    filteredLogs.forEach(log => {
      const lh = Math.floor(log.seconds/3600);
      const lm = Math.floor((log.seconds%3600)/60);
      studyData.push({
        '学习项目': `  └ ${s.title}`,
        '总学习时长': '',
        '进度': '',
        '笔记': `${log.date} 学习${lh>0?lh+'小时':''}${lm}分钟`
      });
    });
  });
  if(studyData.length === 0) studyData.push({ '学习项目':'暂无数据','总学习时长':'','进度':'','笔记':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(studyData), '学习记录');

  // Sheet 5: 长期目标（全部导出）
  const goalData = goals.map(g => ({
    '目标': g.title,
    '时间框架': {year:'年度', month:'月度', none:'长期'}[g.timeframe] || '长期',
    '截止时间': g.date || '不限',
    '进度': `${g.progress||0}%`,
    '现阶段状态': g.status || '',
    '描述': g.note || ''
  }));
  if(goalData.length === 0) goalData.push({ '目标':'暂无数据','时间框架':'','截止时间':'','进度':'','现阶段状态':'','描述':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(goalData), '长期目标');

  // Sheet 6: 心得感悟（按月过滤）
  const refData = reflections
    .filter(r => !filterMonth || (r.date||'').startsWith(filterMonth))
    .map(r => ({
      '日期': (r.date||'').slice(5),
      '待办事项': r.task,
      '心得感悟': r.insight || '',
      '落地转化': r.action || ''
    }));
  if(refData.length === 0) refData.push({ '日期':'','待办事项':'暂无数据','心得感悟':'','落地转化':'' });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(refData), '心得感悟');

  XLSX.writeFile(wb, `工作台备份-${prefix}${todayKey()}.xlsx`);
}

function importAll(){
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json,.xlsx';
  input.onchange = function(e){
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = function(ev){
      try {
        let backup;
        if(file.name.endsWith('.xlsx')){
          const wb = XLSX.read(ev.target.result, {type:'array'});
          const jsonSheets = {};
          wb.SheetNames.forEach(name => {
            const sheet = wb.Sheets[name];
            const json = XLSX.utils.sheet_to_json(sheet, {header:1});
            jsonSheets[name] = json;
          });
          backup = parseExcelBackup(jsonSheets);
        } else {
          backup = JSON.parse(ev.target.result);
          if(!backup.version || !backup.todos) throw new Error('无效的备份文件');
          backup = { todos: backup.todos, works: backup.works, sides: backup.sides, studies: backup.studies, reflections: backup.reflections, goals: backup.goals };
        }
        if(!confirm('导入将覆盖当前所有数据（待办/工作/副业/学习/目标/心得），确定继续？')) return;
        todos = backup.todos || [];
        works = backup.works || [];
        sides = backup.sides || [];
        studies = backup.studies || [];
        reflections = backup.reflections || [];
        goals = backup.goals || [];
        save(K.todo, todos);
        save(K.work, works);
        save(K.side, sides);
        save(K.study, studies);
        save(K.reflection, reflections);
        save(K.goal, goals);
        rolloverTodos();
        renderTodos();
        renderProjects('work');
        renderProjects('side');
        renderStudies();
        renderStudyStats();
        renderReflections();
        renderGoals();
        alert('导入成功！所有数据已恢复。');
      } catch(err){
        alert('导入失败：' + err.message);
      }
    };
    if(file.name.endsWith('.xlsx')){
      reader.readAsArrayBuffer(file);
    } else {
      reader.readAsText(file);
    }
  };
  input.click();
}

function parseExcelBackup(sheets){
  const result = { todos:[], works:[], sides:[], studies:[], reflections:[], goals:[] };

  // 待办
  if(sheets['待办事项']){
    const rows = sheets['待办事项'].slice(1);
    rows.forEach(r => {
      if(r[1] && r[1] !== '暂无数据'){
        const slotMap = {'上午':'morning','下午':'afternoon','晚上':'evening'};
        result.todos.push({
          id: uid(), text: String(r[1]), slot: slotMap[String(r[2]||'')] || 'morning',
          date: String(r[0]||''), done: String(r[3]||'') === '已完成'
        });
      }
    });
  }

  // 工作
  if(sheets['工作项目']){
    const rows = sheets['工作项目'].slice(1);
    rows.forEach(r => {
      if(r[0] && r[0] !== '暂无数据'){
        const statusMap = {'进行中':'active','已完成':'done','搁置':'paused'};
        result.works.push({
          id: uid(), title: String(r[0]), status: statusMap[String(r[1]||'')] || 'active',
          note: String(r[2]||''), createdAt: new Date().toISOString()
        });
      }
    });
  }

  // 副业
  if(sheets['副业项目']){
    const rows = sheets['副业项目'].slice(1);
    rows.forEach(r => {
      if(r[0] && r[0] !== '暂无数据'){
        const statusMap = {'进行中':'active','已完成':'done','搁置':'paused'};
        result.sides.push({
          id: uid(), title: String(r[0]), status: statusMap[String(r[1]||'')] || 'active',
          note: String(r[2]||''), incomes: [], createdAt: new Date().toISOString()
        });
      }
    });
  }

  // 学习
  if(sheets['学习记录']){
    const rows = sheets['学习记录'].slice(1);
    let curStudy = null;
    rows.forEach(r => {
      const name = String(r[0]||'');
      if(!name.startsWith('  └') && name && name !== '暂无数据'){
        curStudy = { id: uid(), title: name, note: String(r[3]||''), progress: parseInt(String(r[2]||'0'))||0, seconds: 0, logs: [], lastLogSeconds: 0 };
        result.studies.push(curStudy);
      } else if(name.startsWith('  └') && curStudy && r[3]){
        // 日志行
        curStudy.logs.push({ date: String(r[3]||'').slice(0,10), seconds: 0 });
      }
    });
  }

  // 目标
  if(sheets['长期目标']){
    const rows = sheets['长期目标'].slice(1);
    rows.forEach(r => {
      if(r[0] && r[0] !== '暂无数据'){
        const tfMap = {'年度':'year','月度':'month','长期':'none'};
        result.goals.push({
          id: uid(), title: String(r[0]), timeframe: tfMap[String(r[1]||'')] || 'none',
          date: String(r[2]||''), progress: parseInt(String(r[3]||'0'))||0,
          status: String(r[4]||''), note: String(r[5]||''), createdAt: new Date().toISOString()
        });
      }
    });
  }

  // 心得
  if(sheets['心得感悟']){
    const rows = sheets['心得感悟'].slice(1);
    rows.forEach(r => {
      if(r[1] && r[1] !== '暂无数据'){
        result.reflections.push({
          id: uid(), task: String(r[1]), date: `2026-${String(r[0]||'')}`,
          insight: String(r[2]||''), action: String(r[3]||''), createdAt: new Date().toISOString()
        });
      }
    });
  }

  return result;
}

// ===== Study Stats =====
function renderStudyStats(){
  const el = document.getElementById('studyStats');
  if(!el) return;

  const now = new Date();
  // 本周范围（周一到周日）
  const day = now.getDay() || 7;
  const weekStart = new Date(now);
  weekStart.setDate(now.getDate() - day + 1);
  weekStart.setHours(0,0,0,0);
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekStart.getDate() + 6);
  weekEnd.setHours(23,59,59,999);
  // 本月范围
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const monthEnd = new Date(now.getFullYear(), now.getMonth()+1, 0, 23,59,59,999);

  let weekTotal = 0, monthTotal = 0;
  const breakdown = []; // {name, weekSec, monthSec}

  studies.forEach(s => {
    let wSec = 0, mSec = 0;
    (s.logs||[]).forEach(log => {
      const d = new Date(log.date + 'T12:00:00');
      if(d >= weekStart && d <= weekEnd) wSec += log.seconds;
      if(d >= monthStart && d <= monthEnd) mSec += log.seconds;
    });
    // 正在计时中的也算进去
    if(timerState.id === s.id){
      const live = Math.floor((Date.now() - timerState.start) / 1000);
      wSec += live; mSec += live;
    }
    weekTotal += wSec;
    monthTotal += mSec;
    if(wSec > 0 || mSec > 0) breakdown.push({ name: s.title, weekSec: wSec, monthSec: mSec });
  });

  function fmt(sec){
    const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60);
    if(h > 0) return `${h}h${m>0?m+'m':''}`;
    return `${m}m`;
  }

  breakdown.sort((a,b) => b.weekSec - a.weekSec);

  let html = `<div class="study-stats-title">📊 学习统计</div>`;
  html += `<div class="stats-grid">
    <div class="stat-box">
      <div class="stat-val">${fmt(weekTotal)}</div>
      <div class="stat-label">本周</div>
    </div>
    <div class="stat-box">
      <div class="stat-val">${fmt(monthTotal)}</div>
      <div class="stat-label">本月</div>
    </div>
  </div>`;

  if(breakdown.length > 0){
    html += `<div class="stat-breakdown">`;
    breakdown.forEach(b => {
      html += `<div class="stat-breakdown-item">
        <span class="sb-name">${escapeHtml(b.name)}</span>
        <span class="sb-time">周 ${fmt(b.weekSec)} · 月 ${fmt(b.monthSec)}</span>
      </div>`;
    });
    html += `</div>`;
  }

  el.innerHTML = html;
}

// ===== Page Switch =====
const pageTitles = { todo:'📋 待办', work:'💼 工作', side:'🌱 副业', study:'📚 学习', goal:'🎯 目标', reflection:'📝 心得' };
function switchPage(name){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.page===name));
  document.getElementById('pageTitle').textContent = pageTitles[name];
  document.getElementById('headerRight').textContent = name==='todo' ? (weekOffset===0?'本周':`${weekOffset}周`) : '';
  document.getElementById('main').scrollTop = 0;
  if(name==='reflection') renderReflections();
  if(name==='goal') renderGoals();
}

// ===== Init =====
function init(){
  rolloverTodos();
  renderWeekInfo();
  renderTodoDaySelect();
  renderTodos();
  renderProjects('work');
  renderProjects('side');
  renderStudies();
  renderStudyStats();
  renderReflections();
  renderGoals();

  // Enter to add
  document.getElementById('todoInput').addEventListener('keydown', e=>{ if(e.key==='Enter') addTodo(); });
  document.getElementById('workInput').addEventListener('keydown', e=>{ if(e.key==='Enter') addProject('work'); });
  document.getElementById('sideInput').addEventListener('keydown', e=>{ if(e.key==='Enter') addProject('side'); });
  document.getElementById('studyInput').addEventListener('keydown', e=>{ if(e.key==='Enter') addStudy(); });
  document.getElementById('goalInput').addEventListener('keydown', e=>{ if(e.key==='Enter') addGoal(); });

  // 目标时间框架联动
  document.getElementById('goalTimeframe').addEventListener('change', function(){
    const dateInput = document.getElementById('goalDate');
    if(this.value === 'none'){
      dateInput.style.display = 'none';
      dateInput.value = '';
    } else {
      dateInput.style.display = '';
    }
  });
}
init();
</script>
</body>
</html>
